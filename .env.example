# Postgres (Neon recommended — https://neon.tech)
# For local dev, create a Neon project and paste the pooled connection string.
# Prod: set this in Vercel env vars.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ServiceMonster API credentials (one pair per company).
# We build the `Authorization: Basic base64(user:pass)` header at request time.
SM_USER_1CLEANAIR=
SM_PASS_1CLEANAIR=

SM_USER_HOMEDEPOT=
SM_PASS_HOMEDEPOT=

SM_USER_ENVIRODUCT=
SM_PASS_ENVIRODUCT=

# ServiceTitan API credentials for the HVAC division (company slug "hvac").
# Same app as the internal booking tool's HVAC tab. ST_ENV=production uses the
# live tenant; anything else uses ServiceTitan's integration sandbox.
ST_ENV=production
ST_TENANT_ID=
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=

# Cron auth (Vercel sends Authorization: Bearer <CRON_SECRET> on cron invocations)
# Set this to any random string. Vercel auto-attaches it when set in project env.
CRON_SECRET=

# Auth: Clerk, shared with the 1CleanAir Hub (Clerk app "Dashboard",
# app_3IguKWRO9yS9aGwNoW8WQ3ExjQv). Local: `clerk env pull` writes the dev keys
# to .env.local. Prod: use the live keys; they only work on *.1cleanair.info.
# Access per user is granted on the hub's /admin page (see src/lib/hub-access.ts).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Prod only: sign-in/up happen on the hub. Leave unset locally to use Clerk's
# dev Account Portal.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://www.1cleanair.info/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://www.1cleanair.info/sign-up
# NEXT_PUBLIC_HUB_URL=https://www.1cleanair.info

# Optional: adds a "contact support" link to /no-access.
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Mobile Punches (time.1cleanair.info): tech hours for the Trucks page. Create a
# key on its API keys page (hub admins or "punches:api-keys"). PUNCHES_URL only
# needs setting to point at another Punches deployment.
PUNCHES_KEY=
# PUNCHES_URL=https://time.1cleanair.info
